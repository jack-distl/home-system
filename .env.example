# Copy to .env and fill in. Everything is optional except where noted.
PORT=3000
TZ=Australia/Perth

# Where the SQLite database lives (default: ./data/planner.db)
# DATA_DIR=./data

# Weather in the top bar (Open-Meteo, no key needed). Defaults to Perth CBD.
LATITUDE=-31.95
LONGITUDE=115.86

# Google Calendar (see docs/03-calendars.md). Needed only if you use Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorised redirect URI" on your Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
